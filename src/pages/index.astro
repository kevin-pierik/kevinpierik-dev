---
import EntryList from "../features/site/components/entry-list.astro";
import PageSection from "../features/site/components/page-section.astro";
import TextLink from "../features/site/components/text-link.astro";
import {
  emailHref,
  pageTitle,
  phoneHref,
  profile,
} from "../features/site/profile";
import { profileStructuredData } from "../features/site/seo/structured-data";
import WebLayout from "../layouts/web.astro";

export const prerender = true;

const { address, email, phone } = profile.contact;
---

<WebLayout description={profile.description} title={pageTitle}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(profileStructuredData())} />
  <main aria-labelledby="page-title" class="flex h-svh flex-col overflow-y-auto overscroll-none bg-black px-3 py-3 text-[0.75rem]/[1.32] font-bold text-white sm:px-[1.35vw] sm:py-[1.35vw]" id="main">
    <header class="grid grid-cols-2 gap-x-[4vw] gap-y-[1.35em] sm:grid-cols-[2fr_3fr_3fr_4fr] sm:gap-x-[1vw] sm:gap-y-0">
      <p>{profile.name}<br />{profile.role}</p>
      <nav aria-label="Social profiles" class="sm:col-start-4">
        <ul>
          {profile.social.map(({ label, href }) => <li><TextLink href={href}>{label}</TextLink></li>)}
        </ul>
      </nav>
    </header>
    <h1 class="mt-auto ml-[-0.088em] text-[14vw]/[0.78] font-bold tracking-[-0.02em]" id="page-title">{profile.name}</h1>
    <div class="mt-[7.8vh] grid grid-cols-2 gap-x-[4vw] gap-y-[1.35em] sm:grid-cols-[2fr_3fr_3fr_4fr] sm:gap-x-[1vw] sm:gap-y-0">
      <div class="flex flex-col gap-[1.35em] sm:col-start-2">
        <PageSection id="education" label="Education"><EntryList entries={profile.education} /></PageSection>
        <PageSection id="skills" label="Software Skills"><EntryList entries={profile.skills} /></PageSection>
      </div>
      <PageSection class="sm:col-start-3" id="experience" label="Work Experience"><EntryList entries={profile.experience} /></PageSection>
      <div class="col-span-2 sm:col-span-1 sm:col-start-4">
        <PageSection id="contact" label="Contact">
          <ul>
            <li class="pl-[3em]">{address.locality}, {address.region}</li>
            <li class="pl-[3em]">{address.country}</li>
            <li class="flex"><span class="w-[3em] shrink-0">P:</span><span><TextLink href={phoneHref}>{phone}</TextLink></span></li>
            <li class="flex"><span class="w-[3em] shrink-0">E:</span><span><TextLink href={emailHref}>{email}</TextLink></span></li>
          </ul>
        </PageSection>
        <PageSection class="mt-[1.35em] max-w-[75%] sm:max-w-[41em]" id="information" label="Information">
          {profile.about.map((paragraph, index) => <p class={index > 0 ? "mt-[1.35em]" : undefined}>{paragraph}</p>)}
        </PageSection>
      </div>
    </div>
  </main>
</WebLayout>
