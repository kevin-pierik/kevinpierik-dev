---
import WebLayout from "../layouts/web.astro";

export const prerender = true;
---

<WebLayout description="This route does not exist on this device." noindex title="Page not found">
  <main class="h-svh" id="main">
    <div class="flex h-full flex-col bg-[#0000a8] bg-[radial-gradient(ellipse_at_top,#0000a8,#000088)] font-mono text-[clamp(0.75rem,2.4vw,0.85rem)]/[1.55] text-[#c6c6c6]">
      <div class="flex shrink-0 items-center justify-between gap-6 bg-[#a8a8a8] px-3 py-1 font-semibold text-[#000080]">
        <span>KPBIOS(C)2026 Kevin Pierik Systems, Inc.</span>
        <span>v4.0.4</span>
      </div>
      <div class="flex-1 overflow-y-auto px-3 py-6 sm:px-6">
        <pre class="whitespace-pre-wrap wrap-anywhere"><span class="block text-[#c6c6c6]">BIOS Date: 08/19/26  17:42:04  Ver: 4.0.4</span><span class="block text-[#c6c6c6]">Kevin Pierik Web Core(tm) CPU @ 3.40GHz</span><span class="block text-[#c6c6c6]">Speed: 3400 MHz</span><span class="block text-[#c6c6c6]"> </span><span class="block text-[#54fcfc]">Press any key to run Setup,  ESC for Boot Menu</span><span class="block text-[#54fcfc]">Initializing static routes ..  Done.</span><span class="block text-[#54fcfc]">65536MB OK</span><span class="block text-[#c6c6c6]"> </span><span class="block text-[#c6c6c6]">Auto-Detecting HTTP routes ...</span><span class="block text-[#c6c6c6]">  Route 0 : /            OK</span><span class="block text-[#c6c6c6]">  Route 4 : <span data-route>Unknown</span>    None</span><span class="block text-[#c6c6c6]"> </span><span class="block text-[#ffffff]">ERROR 404: Requested route not found on this device.</span><span class="block text-[#c6c6c6]">Reboot and select a proper route,</span><span class="block text-[#c6c6c6]">or insert boot media in the selected device and press a key</span></pre>
      </div>
      <div class="flex shrink-0 flex-wrap items-center justify-between gap-x-6 bg-[#a8a8a8] px-1 text-[#000080]">
        <a class="inline-flex min-h-12 items-center px-2 underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#000080]" href="/">Press any key to reboot</a>
        <span class="px-2">F1: Home  ESC: Home</span>
      </div>
    </div>
  </main>
</WebLayout>

<script>
  const route = document.querySelector<HTMLElement>("[data-route]");
  if (route) route.textContent = window.location.pathname;

  const ignoredKeys = new Set(["Tab", "Shift", "Control", "Alt", "Meta"]);
  const reboot = () => window.location.assign("/");
  const onKeyDown = (event: KeyboardEvent) => {
    if (ignoredKeys.has(event.key) || event.metaKey || event.ctrlKey || event.altKey) return;
    reboot();
  };

  window.addEventListener("keydown", onKeyDown);
  window.addEventListener("pointerdown", reboot, { once: true });
</script>
