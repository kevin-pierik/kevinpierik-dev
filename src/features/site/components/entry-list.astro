---
import type { CvEntry } from "../profile";

interface Props {
  entries: CvEntry[];
}

const { entries } = Astro.props;
---

{
  entries.map((entry) => (
    <div>
      <h3 class="text-[1em]/[inherit] font-bold">{entry.title}</h3>
      <ul>
        {entry.lines.map((line) => (
          <li class="pl-[3em]">{line}</li>
        ))}
      </ul>
    </div>
  ))
}
