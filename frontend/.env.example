# Copy to .env.local for local development, and set the same values in Vercel.
# NEXT_PUBLIC_ values end up in the browser; the others stay on the server.

# Sanity: the project and dataset the site reads published content from.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# WebMCP: Chrome origin trial token for https://www.kevinpierik.dev.
# https://developer.chrome.com/origintrials
NEXT_PUBLIC_WEBMCP_TRIAL_TOKEN=

# Newsletter: Cloudflare Turnstile site key and secret key.
# Locally, the test keys 1x00000000000000000000AA and
# 1x0000000000000000000000000000000AA always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Newsletter: Klaviyo private API key (lists:write, profiles:write,
# subscriptions:write) and the id of the list to subscribe to.
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=
