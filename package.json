{
  "name": "kevinpierik-dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "qa": "bun run lint && bun run typecheck",
    "sanity:extract": "sanity schema extract --path ./sanity/schema.json --force",
    "sanity:typegen": "bun run sanity:extract && sanity typegen generate",
    "sanity:seed": "bun run scripts/sanity-seed.ts",
    "sanity:deploy": "sanity deploy",
    "sanity:login": "sanity login",
    "sanity:import": "bun run scripts/sanity-import.ts",
    "sanity:cors": "sanity cors add http://localhost:3000 --credentials",
    "sanity:import:cli": "sanity dataset import seed/content.ndjson production"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@portabletext/react": "^8",
    "@sanity/icons": "^5",
    "@sanity/image-url": "^2",
    "@sanity/vision": "^6",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-sanity": "^13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6",
    "styled-components": "^6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
