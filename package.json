{
  "name": "kevinpierik-dev",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevin-pierik/kevinpierik-dev.git"
  },
  "engines": {
    "node": "26.x"
  },
  "workspaces": [
    "frontend",
    "studio"
  ],
  "scripts": {
    "dev": "bun run typegen && bun --filter '*' --parallel dev",
    "dev:frontend": "bun run typegen && bun --filter frontend dev",
    "dev:studio": "bun --filter studio dev",
    "build": "bun --filter frontend build",
    "build:studio": "bun --filter studio build",
    "lint": "bun --filter '*' lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run typegen && bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "test:watch": "bun --filter frontend test:watch",
    "test:e2e": "bun --filter frontend test:e2e",
    "qa": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run test:e2e",
    "typegen": "bun --filter studio typegen"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
