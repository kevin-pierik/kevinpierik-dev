{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/code-input": "^7.3.16",
    "@sanity/icons": "^5.4.0",
    "@sanity/table": "^3.1.21",
    "@sanity/vision": "^6.24.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.24.0",
    "sanity-plugin-mux-input": "^5.3.1",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7",
    "@types/react": "^19.2.14",
    "eslint": "^10.8.1",
    "prettier": "^3.5",
    "vitest": "^5.1.1",
    "typescript": "~6.0"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
