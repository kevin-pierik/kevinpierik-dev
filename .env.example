# Base URL used for canonicals, sitemap.xml, robots.txt and OG tags.
# Copy this file to .env.local for local development.
PUBLIC_SITE_URL=http://localhost:4321

# Sanity project. Find the ID at https://sanity.io/manage.
# Leave PUBLIC_SANITY_PROJECT_ID empty and the site falls back to the
# content in features/desktop/defaults.ts, so it still builds and renders.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Optional. Defaults to the date the integration was written.
PUBLIC_SANITY_API_VERSION=

# Viewer token. Only needed for draft mode and the Presentation tool: a public
# dataset serves published content without one. Required if you make the dataset
# private. Create it under API > Tokens with Viewer rights. Never commit it.
SANITY_API_READ_TOKEN=

# Only needed once, to run `bun run sanity:import`. Requires Editor rights.
# Delete it again afterwards — the site itself never writes.
SANITY_API_WRITE_TOKEN=
